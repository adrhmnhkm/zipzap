{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KirimAja",
  "version": "0.1.0",
  "identifier": "com.kirimaja.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "KirimAja — Transfer File Cepat & Ringan",
        "width": 880,
        "height": 620,
        "minWidth": 680,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
